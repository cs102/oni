<div id="<%= dom_id word %>">
  
  <div>
    <strong>Grade:</strong>
    <%= word.grade %>
  </div>

  <div>
    <strong>Prefix:</strong>
    <%= word.prefix %>
  </div>

  <div>
    <strong>Suffix:</strong>
    <%= word.suffix %>
  </div>

  <div>
    <strong>Definition:</strong>
    <%= word.definition %>
  </div>

  <div>
    <strong>Example:</strong>
    <%= word.example %>
  </div>

  <div>
    <strong>Origin:</strong>
    <%= word.origin %>
  </div>

  <div>
    <strong>Note:</strong>
    <%= word.note %>
  </div>

</div>
